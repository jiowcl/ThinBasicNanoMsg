USES "CONSOLE"

#INCLUDE Once "..\Core\Nng.inc"

Global sock As Long
Global buf As Asciiz * 256
Global n As Long
Global Rc As Long
Global lTotal As Long
Global lpszSurvey As String

If NngInitDefault() <> $NNG_OK Then
  Printl("nng_init failed: " & NngStrerrorString(NngLastErr))
Else
  Rc = NngSurveyor0Open(sock)
  If Rc <> $NNG_OK Then
    Printl("surveyor open failed: " & NngStrerrorString(Rc))
  Else
    Rc = NngSocketSetMs(sock, "surveyor:survey-time", 2000)
    If Rc <> $NNG_OK Then
      Printl("set survey-time failed: " & NngStrerrorString(Rc))
    End If
    Rc = NngListenDefault(sock, "tcp://0.0.0.0:1702", 0)
    If Rc <> $NNG_OK Then
      Printl("listen failed: " & NngStrerrorString(Rc))
    Else
      Printl("Surveyor listening on tcp://0.0.0.0:1702 (start RespondentClient)")
      While %TRUE
        lTotal = lTotal + 1
        lpszSurvey = "Survey #" & lTotal
        Rc = NngSendString(sock, lpszSurvey, 0)
        If Rc <> $NNG_OK Then
          Printl("send failed: " & NngStrerrorString(Rc))
        Else
          Printl("Survey sent: " & lpszSurvey)
          While %TRUE
            n = NngRecvBuffer(sock, VarPtr(buf), SizeOf(buf), 0)
            If n >= 0 Then
              Printl("Response: " & Left$(buf, n))
            Else
              If NngErrIsTimedOut(NngLastErr) Then
                Printl("Survey deadline reached (NNG_ETIMEDOUT).")
              ElseIf NngLastErr = $NNG_ESTATE Then
                Printl("No survey pending (NNG_ESTATE).")
              Else
                Printl("Recv failed: " & NngStrerrorString(NngLastErr))
              End If
              Exit While
            End If
          Wend
        End If
        Sleep 1000
      Wend
    End If
  End If
  NngSocketClose(sock)
  NngFini()
End If
