#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TBNNG_VERSION_MAJOR,TBNNG_VERSION_MINOR,TBNNG_VERSION_PATCH,TBNNG_VERSION_BUILD
 PRODUCTVERSION TBNNG_VERSION_MAJOR,TBNNG_VERSION_MINOR,TBNNG_VERSION_PATCH,TBNNG_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", TBNNG_COMPANY_NAME
            VALUE "FileDescription", TBNNG_FILE_DESCRIPTION
            VALUE "FileVersion", TBNNG_VERSION_STRING
            VALUE "InternalName", TBNNG_INTERNAL_NAME
            VALUE "LegalCopyright", TBNNG_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", TBNNG_ORIGINAL_FILENAME
            VALUE "ProductName", TBNNG_PRODUCT_NAME
            VALUE "ProductVersion", TBNNG_VERSION_STRING
            VALUE "Comments", TBNNG_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
