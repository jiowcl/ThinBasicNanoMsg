USES "CONSOLE"
USES "NNG"

#INCLUDE Once "SdkInitPath.inc"

Global sock As Long
Global Rc As Long
Global lTotal As Long
Global lpszAddr As String
Global lpszReq As String
Global lpszReply As String

If SdkNngInit() = 0 Then End

lpszAddr = "tcp://0.0.0.0:1700"
sock = NngRep0Open()
If sock <= 0 Then
  Printl("NngRep0Open failed")
  SdkNngShutdown()
  End
End If

Rc = NngListen(sock, lpszAddr, 0)
If Rc <> %NNG_OK Then
  Printl("NngListen failed: " & NngStrerrorString(Rc))
  NngClose(sock)
  SdkNngShutdown()
  End
End If

Printl("REP listening: " & lpszAddr)
lTotal = 0

While %TRUE
  lpszReq = NngRecvStr(sock, 256, 0)
  If Len(lpszReq) = 0 And NngLastErr() <> %NNG_OK Then
    If Not SdkNngErrTimedOut(NngLastErr()) Then
      Printl("NngRecvStr failed: " & NngStrerrorString(NngLastErr()))
    End If
  Else
    lTotal = lTotal + 1
    Printl("Received #" & lTotal & ": " & lpszReq)
    lpszReply = "Hi " & lTotal
    Rc = NngSendStr(sock, lpszReply, 0)
    If Rc <> %NNG_OK Then
      Printl("NngSendStr failed: " & NngStrerrorString(Rc))
    End If
  End If
Wend
