' Prerequisite: copy SDK\C\bin\thinBasic_NNG.dll to C:\thinBasic\Lib\

USES "CONSOLE"
USES "NNG"

#INCLUDE Once "SdkInitPath.inc"

Global s As Long

Printl("NNG SDK smoke")
Printl("APP_SourcePath=" & APP_SourcePath)

If SdkNngInit() = 0 Then End

Printl("NngLibraryLoaded: " & NngLibraryLoaded())
s = NngRep0Open()
If s <= 0 Then
  Printl("NngRep0Open failed")
Else
  Printl("rep socket=" & s)
  NngClose(s)
End If
SdkNngShutdown()
Printl("NNG SDK smoke OK")
