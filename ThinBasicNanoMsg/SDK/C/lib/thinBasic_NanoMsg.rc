#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TBNMSG_VERSION_MAJOR,TBNMSG_VERSION_MINOR,TBNMSG_VERSION_PATCH,TBNMSG_VERSION_BUILD
 PRODUCTVERSION TBNMSG_VERSION_MAJOR,TBNMSG_VERSION_MINOR,TBNMSG_VERSION_PATCH,TBNMSG_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", TBNMSG_COMPANY_NAME
            VALUE "FileDescription", TBNMSG_FILE_DESCRIPTION
            VALUE "FileVersion", TBNMSG_VERSION_STRING
            VALUE "InternalName", TBNMSG_INTERNAL_NAME
            VALUE "LegalCopyright", TBNMSG_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", TBNMSG_ORIGINAL_FILENAME
            VALUE "ProductName", TBNMSG_PRODUCT_NAME
            VALUE "ProductVersion", TBNMSG_VERSION_STRING
            VALUE "Comments", TBNMSG_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
